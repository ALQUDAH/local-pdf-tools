{
  "name": "local-pdf-tools",
  "version": "1.1.0",
  "description": "Free, open-source, privacy-first PDF toolkit. 30+ tools (merge, split, compress, OCR, sign, redact, edit...) that run entirely in your browser.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "alqudah (https://github.com/alqudah)",
  "homepage": "https://alqudah.github.io/local-pdf-tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alqudah/local-pdf-tools.git"
  },
  "bugs": {
    "url": "https://github.com/alqudah/local-pdf-tools/issues"
  },
  "keywords": [
    "pdf",
    "pdf-tools",
    "pdf-editor",
    "merge-pdf",
    "split-pdf",
    "compress-pdf",
    "ocr",
    "privacy",
    "offline",
    "client-side",
    "browser",
    "react",
    "pdf-lib",
    "pdfjs",
    "self-hosted",
    "ilovepdf-alternative",
    "smallpdf-alternative"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron desktop",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "docx": "^9.15.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "tailwindcss": "^4.3.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@types/node": "$@types/node"
  }
}
