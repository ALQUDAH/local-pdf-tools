# All variables are optional. They are only used by the self-hosted Node server
# (npm run dev / npm start / Docker). The static build needs none of them.

# Port and interface the server listens on.
PORT=3000
HOST=0.0.0.0

# Google Gemini API key, used only by the "Translate PDF" tool.
# Without it, Translate PDF returns an untranslated preview.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash
